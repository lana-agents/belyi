import Mathlib.Topology.Algebra.Category.ProfiniteGrp.Basic
import Mathlib.Topology.Algebra.OpenSubgroup
import Mathlib.GroupTheory.Commensurable
import Pi1.Profinite.Slim

/-!
# Chains of elementary operations on profinite groups ([AbsTopI] Definition 4.2 (iii)–(v))

Mochizuki's *Topics in Absolute Anabelian Geometry I*, §4 (text file
`Topics in Absolute Anabelian Geometry I.txt`, Definition 4.2, l.2835–3082) attaches to an
extension `1 → Δ → Π → G → 1` of GSAFG-type with slim `G` the category `Chain(Π)` of
`Π`-chains `Π₀ ⇝ Π₁ ⇝ … ⇝ Πₙ`: slim profinite groups `Π_j` with open "rigidifying
homomorphisms" `ρ_j` from open subgroups of `Π`, linked by *elementary operations* of four types
(Def 4.2 (iii) (a)–(d), l.2989–3020):

* `⋏` (`ElemOp.cover`): an open immersion `Π_{j+1} ↪ Π_j` (a finite étale covering);
* `⋎` (`ElemOp.quot`): an open immersion `Π_j ↪ Π_{j+1}` (a finite étale quotient);
* `•` (`ElemOp.decusp`): a surjection `Π_j ↠ Π_{j+1}` whose kernel is topologically normally
  generated *in `Δ_j`* (`ChainObj.deltaNormalClosure`) by a cuspidal decomposition group `C` in
  `Δ_j` contained in some normal open torsion-free subgroup of `Δ_j` (a de-cuspidalisation of a
  single rational cusp, see below);
* `⊚` (`ElemOp.deorb`): a surjection `Π_j ↠ Π_{j+1}` whose kernel is topologically normally
  generated by a finite closed subgroup of `Δ_j` (a de-orbification).

The cuspidal decomposition groups in `Δ_j` are the commensurators in `Δ_j` of the nontrivial
images under `ρ_j` of the cuspidal decomposition groups of `Π` (condition (3Π), l.2980). The latter
are part of the input (`CuspidalExt.cusps`); for an `l`-cyclotomically full `G` they are
determined by `Π` itself ([AbsTopI] Lemma 4.5 (v)), which is a separate algorithm.

**Normal generation in `Δ_j` for `•`.** The kernel of a `•` operation is the closed subgroup
generated by the `Δ_j`-conjugates of `C`, not by its `Π_j`-conjugates. This is how the
definition is used in the proof of [AbsTopI] Theorem 4.7 (i) (l.3507–3510): there the
"`k_{j+1}`-rationality … of the cusp … follows immediately from Lemma 4.1, (vi), by taking `x_B`
to be the various Galois conjugates of this point". Lemma 4.1 (v), (vi) (l.2753–2772) concern
the quotient `ψ_A : Δ ↠ Δ_A` by the closed normal subgroup *of `Δ`* generated by the
decomposition group `A` of a cusp `x_A`, and say that the decomposition group of any other cusp
`x_B ≠ x_A` survives in `Δ_A`. Since `Ker(φ)` is normal in `Π_j`, it contains the decomposition
groups of all Galois conjugates of `x_A`; as `Ker(φ)` is the `Δ_j`-normal closure of `C`, Lemma
4.1 (vi) forces every Galois conjugate of `x_A` to be `x_A`, i.e. the cusp is rational, matching
the `X`-chain side ([AbsTopI] Definition 4.2 (i) (c), l.2901–2906: "the complement of a single
`k_{j+1}`-valued point"). With the `Π_j`-normal closure the rationality would not follow (that
kernel fills the whole Galois orbit). Accordingly the scheme-theoretic Belyi chains of [AbsTopII]
Example 3.6 (l.4634–4635, l.4667–4668) first enlarge the base field so that all the cusps to be
filled are rational.

Everything here is group theory: no geometric object is involved. The comparison with chains of
curves ([AbsTopI] Theorem 4.7 (i)) is the geometric half of MR8.

## Main definitions

* `Belyi.Anabelian.CuspidalExt`: the input `(Π ↠ G, {cusps})`;
* `Belyi.Anabelian.ChainObj`: a slim profinite group with rigidifying data (conditions (1Π),
  (2Π));
* `Belyi.Anabelian.ElemOp`, `Belyi.Anabelian.OpKind`: elementary operations and their types;
* `Belyi.Anabelian.PiChain`, `PiChain.typeChain`: `Π`-chains and their type-chains;
* `Belyi.Anabelian.PiChain.Iso`, `Belyi.Anabelian.PiChain.TerminalIso`: the morphisms of
  `Chain(Π)` and of `Chain^{iso-trm}(Π)`;
* `Belyi.Anabelian.PiChain.IsEtLoc`: the chains of `ÉtLoc(Π)` (type-chain in `{⋏, ⋎}`).
-/

universe u

namespace Belyi.Anabelian

open Pi1.Profinite

/-- The input of the group-theoretic algorithms of [AbsTopI] §4 / [AbsTopII] §3: a surjection
of profinite groups `Π ↠ G` (an extension `1 → Δ → Π → G → 1`) with `G` slim and `Δ` slim and
nontrivial, together with the set of cuspidal decomposition groups of `Π` (subgroups of `Δ`).
The `Prop` fields are the defining conditions of the notion. -/
structure CuspidalExt where
  /-- The arithmetic fundamental group `Π`. -/
  Pi : ProfiniteGrp.{u}
  /-- The Galois group `G`. -/
  G : ProfiniteGrp.{u}
  /-- The projection `Π ↠ G`. -/
  pr : Pi →ₜ* G
  pr_surjective : Function.Surjective pr
  slim_G : IsSlim G
  slim_delta : IsSlim (pr : Pi →* G).ker
  nontrivial_delta : (pr : Pi →* G).ker ≠ ⊥
  /-- The decomposition groups of the cusps (in `Δ`). -/
  cusps : Set (Subgroup Pi)
  cusps_le : ∀ I ∈ cusps, I ≤ (pr : Pi →* G).ker

namespace CuspidalExt

variable (E : CuspidalExt.{u})

/-- The geometric fundamental group `Δ = ker(Π ↠ G)`. -/
def Delta : Subgroup E.Pi := (E.pr : E.Pi →* E.G).ker

end CuspidalExt

/-- An object of a `Π`-chain ([AbsTopI] Definition 4.2 (iii), conditions (1Π), (2Π)): a profinite
group `Π_j` with an open rigidifying homomorphism `ρ_j : H_j → Π_j` from an open subgroup
`H_j ⊆ Π`, and an open homomorphism `Π_j → G` (onto `G_j`) compatible with `ρ_j` and `Π ↠ G`,
whose kernel `Δ_j` is slim and nontrivial. -/
structure ChainObj (E : CuspidalExt.{u}) where
  /-- The profinite group `Π_j`. -/
  grp : ProfiniteGrp.{u}
  /-- The open subgroup `H_j ⊆ Π` on which the rigidifying homomorphism is defined. -/
  dom : OpenSubgroup E.Pi
  /-- The rigidifying homomorphism `ρ_j : H_j → Π_j`. -/
  rho : (dom : Subgroup E.Pi) →ₜ* grp
  isOpen_range_rho : IsOpen (Set.range rho)
  /-- The projection `Π_j ↠ G_j ⊆ G`. -/
  toG : grp →ₜ* E.G
  isOpen_range_toG : IsOpen (Set.range toG)
  toG_rho : ∀ h, toG (rho h) = E.pr h
  slim_delta : IsSlim (toG : grp →* E.G).ker
  nontrivial_delta : (toG : grp →* E.G).ker ≠ ⊥

namespace ChainObj

variable {E : CuspidalExt.{u}}

/-- `Δ_j = ker(Π_j → G)`. -/
def Delta (A : ChainObj E) : Subgroup A.grp := (A.toG : A.grp →* E.G).ker

/-- The image `ρ_j(I ∩ H_j)` of a subgroup `I ⊆ Π`. -/
def image (A : ChainObj E) (I : Subgroup E.Pi) : Subgroup A.grp :=
  (I.subgroupOf (A.dom : Subgroup E.Pi)).map (A.rho : (A.dom : Subgroup E.Pi) →* A.grp)

/-- A **cuspidal decomposition group in `Δ_j`** ([AbsTopI] Definition 4.2 (iii), (3Π), l.2980):
the commensurator in `Δ_j` of a nontrivial image under `ρ_j` of a cuspidal decomposition group of
`Π`. -/
def IsCuspidal (A : ChainObj E) (C : Subgroup A.grp) : Prop :=
  ∃ I ∈ E.cusps, A.image I ≠ ⊥ ∧ C = Subgroup.Commensurable.commensurator (A.image I) ⊓ A.Delta

/-- `C` is contained in some normal open torsion-free subgroup of `Δ_j`. -/
def InTorsionFreeNormalOpen (A : ChainObj E) (C : Subgroup A.grp) : Prop :=
  ∃ N : Subgroup A.grp, N ≤ A.Delta ∧ C ≤ N ∧
    (∀ d ∈ A.Delta, ∀ n ∈ N, d * n * d⁻¹ ∈ N) ∧
    IsOpen ((N.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta) ∧
    ∀ n ∈ N, IsOfFinOrder n → n = 1

/-- The closed subgroup of `Π_j` **topologically normally generated by `C` in `Δ_j`**: the
closure of the subgroup generated by the `Δ_j`-conjugates `d c d⁻¹` (`d ∈ Δ_j`, `c ∈ C`). For
`C ≤ Δ_j` this is the image of the closed normal subgroup of `Δ_j` generated by `C`. -/
def deltaNormalClosure (A : ChainObj E) (C : Subgroup A.grp) : Subgroup A.grp :=
  (Subgroup.closure {x | ∃ d ∈ A.Delta, ∃ c ∈ C, d * c * d⁻¹ = x}).topologicalClosure

/-- A homomorphism `φ : Π_j → Π_{j'}` is **compatible with the rigidifying homomorphisms**:
`φ ∘ ρ_j = ρ_{j'}` on some open subgroup of `Π` (rigidifying homomorphisms are homomorphisms from
the projective system of open subgroups of `Π`). -/
def Compat (A B : ChainObj E) (φ : A.grp →ₜ* B.grp) : Prop :=
  ∃ H : OpenSubgroup E.Pi, ∃ (hA : H ≤ A.dom) (hB : H ≤ B.dom),
    ∀ h (hh : h ∈ H), φ (A.rho ⟨h, hA hh⟩) = B.rho ⟨h, hB hh⟩

/-- The trivial chain object `Π₀ = Π` with the identity as rigidifying homomorphism
(condition (0Π)). -/
def base (E : CuspidalExt.{u}) : ChainObj E where
  grp := E.Pi
  dom := ⊤
  rho := ⟨(Subgroup.subtype _), continuous_subtype_val⟩
  isOpen_range_rho := by
    convert isOpen_univ
    refine Set.eq_univ_of_forall fun x ↦ ⟨⟨x, trivial⟩, rfl⟩
  toG := E.pr
  isOpen_range_toG := by
    rw [E.pr_surjective.range_eq]
    exact isOpen_univ
  toG_rho _ := rfl
  slim_delta := E.slim_delta
  nontrivial_delta := E.nontrivial_delta

end ChainObj

/-- The four types of elementary operations: `⋏` (finite étale covering), `⋎` (finite étale
quotient), `•` (de-cuspidalisation), `⊚` (de-orbification). -/
inductive OpKind
  | cover
  | quot
  | decusp
  | deorb
  deriving DecidableEq

open ChainObj in
/-- An **elementary operation** `Π_j ⇝ Π_{j+1}` ([AbsTopI] Definition 4.2 (iii) (a)–(d)). The
operation homomorphism is compatible with the rigidifying homomorphisms. -/
inductive ElemOp {E : CuspidalExt.{u}} (A B : ChainObj E) : Type u
  /-- Type `⋏`: an open immersion `φ : Π_{j+1} ↪ Π_j`. -/
  | cover (φ : B.grp →ₜ* A.grp) (inj : Function.Injective φ) (isOpen : IsOpen (Set.range φ))
      (compat : Compat B A φ)
  /-- Type `⋎`: an open immersion `φ : Π_j ↪ Π_{j+1}`. -/
  | quot (φ : A.grp →ₜ* B.grp) (inj : Function.Injective φ) (isOpen : IsOpen (Set.range φ))
      (compat : Compat A B φ)
  /-- Type `•`: a surjection `φ : Π_j ↠ Π_{j+1}` whose kernel is topologically normally generated
  in `Δ_j` (`ChainObj.deltaNormalClosure`) by a cuspidal decomposition group `C` in `Δ_j` lying
  in a normal open torsion-free subgroup (for "in `Δ_j`" see the module docstring). -/
  | decusp (φ : A.grp →ₜ* B.grp) (surj : Function.Surjective φ) (C : Subgroup A.grp)
      (cusp : A.IsCuspidal C) (tf : A.InTorsionFreeNormalOpen C)
      (ker : (φ : A.grp →* B.grp).ker = A.deltaNormalClosure C)
      (compat : Compat A B φ)
  /-- Type `⊚`: a surjection `φ : Π_j ↠ Π_{j+1}` whose kernel is topologically normally generated
  by a finite closed subgroup `F` of `Δ_j`. -/
  | deorb (φ : A.grp →ₜ* B.grp) (surj : Function.Surjective φ) (F : Subgroup A.grp)
      (le : F ≤ A.Delta) (finite : (F : Set A.grp).Finite)
      (ker : (φ : A.grp →* B.grp).ker = (Subgroup.normalClosure (F : Set A.grp)).topologicalClosure)
      (compat : Compat A B φ)

namespace ElemOp

variable {E : CuspidalExt.{u}} {A B : ChainObj E}

/-- The type `⋏, ⋎, •, ⊚` of an elementary operation. -/
def kind : ElemOp A B → OpKind
  | cover .. => .cover
  | quot .. => .quot
  | decusp .. => .decusp
  | deorb .. => .deorb

end ElemOp

/-- A **`Π`-chain** `Π₀ ⇝ Π₁ ⇝ … ⇝ Πₙ` ([AbsTopI] Definition 4.2 (iii)), starting at the trivial
chain object: `Π₀ = Π` with its natural rigidifying homomorphism (condition (0Π)), i.e. `Π₀` is
identified with `Π` compatibly with the rigidifying homomorphisms. -/
structure PiChain (E : CuspidalExt.{u}) where
  /-- The length `n`. -/
  len : ℕ
  /-- The objects `Π₀, …, Πₙ`. -/
  obj : Fin (len + 1) → ChainObj E
  obj_zero : ∃ e : (obj 0).grp ≃ₜ* E.Pi,
    ChainObj.Compat (obj 0) (ChainObj.base E)
      (ContinuousMonoidHom.toContinuousMonoidHom e : (obj 0).grp →ₜ* E.Pi)
  /-- The elementary operations `Π_j ⇝ Π_{j+1}`. -/
  op : ∀ j : Fin len, ElemOp (obj j.castSucc) (obj j.succ)

namespace PiChain

variable {E : CuspidalExt.{u}}

/-- The **type-chain** of a `Π`-chain: the sequence of types of its elementary operations. -/
def typeChain (c : PiChain E) : List OpKind :=
  List.ofFn fun j ↦ (c.op j).kind

/-- The last object `Πₙ` of a chain. -/
def last (c : PiChain E) : ChainObj E := c.obj (Fin.last c.len)

/-- The trivial chain (of length `0`). -/
def trivial (E : CuspidalExt.{u}) : PiChain E where
  len := 0
  obj _ := ChainObj.base E
  obj_zero := ⟨ContinuousMulEquiv.refl _, ⊤, le_rfl, le_rfl, fun _ _ ↦ rfl⟩
  op j := j.elim0

/-- An **isomorphism of `Π`-chains** with identical type-chains ([AbsTopI] Definition 4.2 (iv)):
isomorphisms `Π_j ≅ Ψ_j` compatible with the rigidifying homomorphisms. (Compatibility with the
operation homomorphisms is automatic, as all groups involved are slim.) -/
structure Iso (c c' : PiChain E) where
  len_eq : c.len = c'.len
  typeChain_eq : c.typeChain = c'.typeChain
  /-- The isomorphisms `Π_j ≅ Ψ_j`. -/
  iso : ∀ j : Fin (c.len + 1), (c.obj j).grp ≃ₜ* (c'.obj (Fin.cast (congrArg (· + 1) len_eq) j)).grp
  compat : ∀ j, ChainObj.Compat (c.obj j) (c'.obj (Fin.cast (congrArg (· + 1) len_eq) j))
    (ContinuousMonoidHom.toContinuousMonoidHom (iso j))

/-- A **terminal isomorphism** of `Π`-chains ([AbsTopI] Definition 4.2 (iv), l.3036): an open
isomorphism `Πₙ ≅ Ψ_m` of the last groups compatible, up to an inner automorphism of `G`, with the
homomorphisms `Πₙ → G`, `Ψ_m → G`. (In `Chain^{iso-trm}(Π)` these are taken up to inner
automorphisms of `Ψ_m`.) -/
structure TerminalIso (c c' : PiChain E) where
  /-- The isomorphism `Πₙ ≅ Ψ_m`. -/
  iso : c.last.grp ≃ₜ* c'.last.grp
  over : ∃ g : E.G, ∀ x, c'.last.toG (iso x) = g * c.last.toG x * g⁻¹

/-- The chains of `ÉtLoc(Π) = Chain^{iso-trm}(Π){⋏, ⋎}` ([AbsTopI] Definition 4.2 (v)). -/
def IsEtLoc (c : PiChain E) : Prop :=
  ∀ t ∈ c.typeChain, t = .cover ∨ t = .quot

end PiChain

end Belyi.Anabelian
